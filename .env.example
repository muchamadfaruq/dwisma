# Salin file ini menjadi .env lalu sesuaikan nilainya.
NODE_ENV=production
PORT=3000

# Wajib: string acak panjang untuk mengamankan sesi login.
# Buat dengan: openssl rand -hex 32
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Akun admin yang dibuat otomatis saat database pertama kali dibuat.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-kuat

# Opsional: API key DeepSeek. Bisa juga diisi lewat GUI admin setelah login.
DEEPSEEK_API_KEY=

# Set 1 bila portal diakses lewat HTTPS (mis. di belakang reverse proxy TLS),
# agar cookie sesi login ditandai Secure. Biarkan 0 untuk akses HTTP langsung.
COOKIE_SECURE=0
