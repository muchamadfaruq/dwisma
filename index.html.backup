    <div id="ai-chat-label">Tanya AI Dwisma</div>

    <button id="ai-chat-btn" onclick="toggleChat()" aria-label="Chat AI">
        <i class="bi bi-stars"></i>
    </button>

    <div id="ai-chat-panel">
        <div id="ai-chat-header">
            <i class="bi bi-robot"></i>
            <span>AI Assistant Dwisma</span>
            <button id="ai-chat-close" onclick="toggleChat()">&times;</button>
        </div>
        <div id="ai-chat-messages">
            <div class="chat-msg bot">
                <i class="bi bi-robot"></i> Halo! Ada yang bisa saya bantu tentang SMA Negeri 2 Mengwi?
            </div>
            <div id="chat-quick-qs" style="display:flex;flex-wrap:wrap;gap:6px;padding:8px 12px">
                <button class="quick-q" onclick="quickChat('Siapa kepala sekolah?')">Kepala Sekolah</button>
                <button class="quick-q" onclick="quickChat('Apa saja aplikasi sekolah?')">Aplikasi</button>
                <button class="quick-q" onclick="quickChat('Siapa wakasek kurikulum?')">Wakasek</button>
                <button class="quick-q" onclick="quickChat('Kapan hari pertama masuk?')">Kalender</button>
                <button class="quick-q" onclick="quickChat('Apa NPSN sekolah?')">NPSN</button>
            </div>
        </div>
        <div id="ai-chat-input-area">
            <input id="ai-chat-input" type="text" placeholder="Ketik pesan..." autocomplete="off"
                onkeydown="if(event.key==='Enter')sendChat()">
            <button id="ai-chat-send" onclick="sendChat()"><i class="bi bi-send-fill"></i></button>
        </div>
    </div>

    <script src="/js/legacy.js" defer></script>
    <script src="/js/portal.js" defer></script>
