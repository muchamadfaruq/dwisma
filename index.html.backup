<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Portal Aplikasi SMAN 2 Mengwi</title>
    <link rel="shortcut icon" href="/img/favicon.ico" />

    <!-- PWA Support -->
    <link rel="manifest" href="/manifest.json" />
    <link rel="stylesheet" href="/css/styles.css" />
    <meta name="theme-color" content="#0061ff" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Dwisma Portal" />
    <link rel="apple-touch-icon" href="/img/Logo Dwisma.png" />
    <meta name="description"
        content="Portal aplikasi resmi SMAN 2 Mengwi – akses semua layanan sekolah dalam satu tempat." />

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Icons & Fonts -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Merriweather:ital,wght@0,700;1,700&display=swap"
        rel="stylesheet" />

    <!-- Tailwind Configuration -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        merriweather: ['Merriweather', 'serif'],
                    },
                    colors: {
                        dwisma: {
                            blue: '#0061ff',
                            dark: '#0f172a',
                            light: '#f8f9fa',
                        }
                    },
                    boxShadow: {
                        'glass': '0 8px 32px 0 rgba(31, 38, 135, 0.05)',
                        'icon': '0 10px 20px -5px rgba(0,0,0,0.1)',
                    },
                    animation: {
                        'fade-in-up': 'fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards',
                        'float': 'float 6s ease-in-out infinite',
                        'blob': 'blob 10s infinite',
                        'gradient-text': 'gradient 8s linear infinite',
                    },
                    keyframes: {
                        fadeInUp: {
                            '0%': { opacity: '0', transform: 'translateY(30px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-15px)' },
                        },
                        blob: {
                            '0%': { transform: 'translate(0px, 0px) scale(1)' },
                            '33%': { transform: 'translate(30px, -50px) scale(1.1)' },
                            '66%': { transform: 'translate(-20px, 20px) scale(0.9)' },
                            '100%': { transform: 'translate(0px, 0px) scale(1)' },
                        },
                        gradient: {
                            '0%': { backgroundPosition: '0% 50%' },
                            '50%': { backgroundPosition: '100% 50%' },
                            '100%': { backgroundPosition: '0% 50%' },
                        }
                    }
                }
            }
        }
    </script>

</head>

<body
    class="font-sans text-dwisma-dark min-h-screen flex flex-col antialiased selection:bg-blue-600 selection:text-white relative overflow-x-hidden">

    <!-- Ambient Background Blobs (Canggih Effect) -->
    <!-- mix-blend-multiply dihapus: property ini paksa GPU re-composite
         seluruh halaman di setiap frame scroll — sangat mahal -->
    <div class="fixed top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
        <div id="blob1"
            class="absolute top-[-10%] left-[-10%] w-96 h-96 bg-purple-400/40 rounded-full filter blur-[100px] animate-blob"
            style="will-change: transform; transform: translateZ(0);">
        </div>
        <div id="blob2"
            class="absolute top-[20%] right-[-10%] w-96 h-96 bg-cyan-400/40 rounded-full filter blur-[100px] animate-blob animation-delay-2000"
            style="will-change: transform; transform: translateZ(0);">
        </div>
        <div id="blob3"
            class="absolute bottom-[-20%] left-[20%] w-[500px] h-[500px] bg-pink-400/30 rounded-full filter blur-[120px] animate-blob animation-delay-4000"
            style="will-change: transform; transform: translateZ(0);">
        </div>
    </div>

    <!-- Navigasi -->
    <nav class="sticky top-0 z-50 glass-panel border-b border-white/60 shadow-sm transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-20 items-center">

                <!-- Logo Brand -->
                <div class="flex-shrink-0 flex items-center gap-3 group cursor-pointer"
                    onclick="window.location.reload()">
                    <div class="flex items-center gap-2">
                        <img src="/img/logo-pemprov-bali.png" alt="Logo Pemprov Bali"
                            class="h-10 w-10 object-contain drop-shadow-sm group-hover:scale-105 transition-transform duration-300" />
                        <img src="/img/Logo Dwisma.png" alt="Logo SMAN 2 Mengwi"
                            class="h-10 w-10 object-contain drop-shadow-sm group-hover:scale-105 transition-transform duration-300" />
                        <div class="h-6 w-[1px] bg-slate-300/80 self-center hidden sm:block"></div>
                        <img src="/img/Logo_Kemendikdasmen.png" alt="Logo Kemendikdasmen"
                            class="h-7 w-auto object-contain hidden sm:block group-hover:scale-105 transition-transform duration-300" />
                    </div>
                    <span
                        class="text-2xl font-black tracking-tighter transition-transform duration-300 group-hover:scale-105 ml-1">
                        <span
                            class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">dwisma.</span><span
                            class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-rose-600">id</span>
                    </span>
                </div>

                <!-- Desktop Right -->
                <div class="hidden md:flex items-center gap-2">
                    <button id="dark-toggle"
                        class="flex items-center justify-center w-10 h-10 rounded-full bg-white/60 border border-white hover:bg-white text-slate-600 hover:text-amber-500 shadow-sm transition-all duration-300"
                        onclick="toggleDark()" aria-label="Toggle Dark Mode">
                        <i id="dark-icon" class="bi bi-moon-fill text-lg"></i>
                    </button>
                </div>

                <!-- Mobile Right -->
                <div class="md:hidden flex items-center gap-2">
                    <button id="dark-toggle-mobile"
                        class="flex items-center justify-center w-10 h-10 rounded-full bg-white/60 border border-white hover:bg-white text-slate-600 hover:text-amber-500 shadow-sm transition-all duration-300"
                        onclick="toggleDark()" aria-label="Toggle Dark Mode">
                        <i id="dark-icon-mobile" class="bi bi-moon-fill text-lg"></i>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Header & Hero -->
    <main class="flex-grow container mx-auto px-4 py-16">
        <div class="text-center max-w-4xl mx-auto mb-20 relative">
            <!-- Authority Badge (Pemprov Bali & Kemendikdasmen) -->
            <div class="flex justify-center mb-6 animate-fade-in-up">
                <div
                    class="px-5 py-2.5 bg-white/70 backdrop-blur-md border border-white/80 rounded-full shadow-[0_8px_30px_rgb(0,0,0,0.04)] flex items-center gap-3.5 hover:shadow-[0_8px_30px_rgba(0,97,255,0.1)] hover:scale-105 transition-all duration-300">
                    <img src="/img/logo-pemprov-bali.png" alt="Logo Pemprov Bali"
                        class="h-7 md:h-9 w-auto object-contain" />
                    <div class="h-5 w-[1px] bg-slate-300/80"></div>
                    <img src="/img/Logo_Kemendikdasmen.png" alt="Logo Kemendikdasmen"
                        class="h-7 md:h-9 w-auto object-contain" />
                </div>
            </div>

            <!-- Floating Logo with Neon Glow -->
            <div class="relative inline-block animate-float">
                <div class="absolute inset-0 bg-blue-500/30 blur-[40px] rounded-full scale-150"></div>
                <a href="https://sman2mengwi.sch.id" target="_blank" title="Situs Resmi SMAN 2 Mengwi"
                    class="relative block hover:scale-110 transition-transform duration-500">
                    <img src="/img/Logo Dwisma.png" alt="Logo SMAN 2 Mengwi"
                        class="w-36 md:w-44 mx-auto drop-shadow-[0_20px_30px_rgba(0,0,0,0.2)] mb-8" />
                </a>
            </div>

            <p class="font-merriweather italic text-xl md:text-2xl text-slate-600 font-bold mb-2 animate-fade-in-up">
                SMAN 2 Mengwi
            </p>

            <h1
                class="font-extrabold text-5xl md:text-7xl text-dwisma-dark mt-2 tracking-tight leading-[1.1] animate-fade-in-up delay-100 min-h-[110px] md:min-h-[150px]">
                <span id="typed-text-1"></span><br class="hidden md:block" />
                <span id="typed-text-2"
                    class="text-gradient-animated bg-gradient-to-r from-blue-600 via-indigo-500 to-cyan-400 animate-gradient pb-2 inline-block"></span><span
                    id="cursor-main" class="animate-pulse font-light text-slate-800 ml-1">|</span>
            </h1>

            <p class="mt-4 text-base md:text-lg text-slate-600 font-bold h-[28px] animate-fade-in-up delay-200">
                <span id="typed-text-3"></span><span id="cursor-sub"
                    class="hidden animate-pulse font-light text-slate-800 ml-1">|</span>
            </p>

            <p class="mt-8 text-lg md:text-xl text-slate-500 font-medium animate-fade-in-up delay-300">
                Kunjungi situs resmi:
                <a href="https://sman2mengwi.sch.id" target="_blank"
                    class="inline-flex items-center gap-1.5 px-4 py-1.5 ml-1 bg-white/60 border border-white rounded-full shadow-sm text-blue-600 hover:bg-blue-600 hover:text-white font-bold transition-all duration-300">
                    sman2mengwi.sch.id <i class="bi bi-arrow-up-right text-sm"></i>
                </a>
            </p>
        </div>

        <!-- Links Grid Section -->
        <div class="max-w-6xl mx-auto space-y-20 pb-20 animate-fade-in-up delay-400">

            <!-- Search Bar Global -->
            <div class="relative max-w-lg mx-auto">
                <i
                    class="bi bi-search absolute left-5 top-1/2 -translate-y-1/2 text-slate-400 text-lg pointer-events-none"></i>
                <input id="search-input" type="text" placeholder="Cari di portal..."
                    oninput="searchApps(this.value)"
                    class="w-full pl-12 pr-12 py-3.5 rounded-full bg-white/60 backdrop-blur border border-white/80 text-slate-700 placeholder-slate-400 font-semibold text-sm outline-none focus:ring-2 focus:ring-blue-400/50 focus:border-blue-400 transition-all shadow-sm">
                <button onclick="document.getElementById('search-input').value='';searchApps('')"
                    class="absolute right-3 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-slate-200/60 hover:bg-slate-300/80 text-slate-500 flex items-center justify-center transition-all text-sm hover:bg-red-200 hover:text-red-500">
                    <i class="bi bi-x"></i>
                </button>
            </div>

            <div id="search-empty" class="hidden flex-col items-center gap-3 py-12 text-slate-400 -mt-12">
                <i class="bi bi-inbox text-5xl"></i>
                <p class="font-bold text-lg">Tidak ditemukan</p>
                <p class="text-sm">Coba kata kunci lain</p>
            </div>

            <!-- Kalender Akademik -->
            <section id="search-section-kalender" class="perf-section search-section">
                <div class="flex items-center justify-center gap-4 mb-6">
                    <div class="h-[2px] bg-gradient-to-r from-transparent via-blue-300 to-transparent flex-grow max-w-xs">
                    </div>
                    <h2
                        class="font-sans font-black text-slate-800 tracking-widest uppercase text-sm md:text-base px-8 py-2.5 bg-white/60 backdrop-blur border border-white shadow-sm rounded-full text-center">
                        <i
                            class="bi bi-calendar-event text-transparent bg-clip-text bg-gradient-to-r from-emerald-500 to-teal-500 mr-2"></i>
                        Kalender Akademik
                    </h2>
                    <div class="h-[2px] bg-gradient-to-r from-transparent via-blue-300 to-transparent flex-grow max-w-xs">
                    </div>
                </div>

                <div id="kalender-list" class="relative max-w-3xl mx-auto">
                    <div class="text-center py-12 text-slate-400">
                        <i class="bi bi-calendar-week text-5xl block mb-4"></i>
                        <p class="font-semibold text-lg">Memuat kalender...</p>
                    </div>
                </div>
            </section>

            <!-- Aplikasi Sekolah -->
            <section class="perf-section search-section" id="search-section-aplikasi">
                <div class="flex items-center justify-center gap-4 mb-10">
                    <div
                        class="h-[2px] bg-gradient-to-r from-transparent via-blue-300 to-transparent flex-grow max-w-xs">
                    </div>
                    <h2
                        class="font-sans font-black text-slate-800 tracking-widest uppercase text-sm md:text-base px-8 py-2.5 bg-white/60 backdrop-blur border border-white shadow-sm rounded-full text-center">
                        <i
                            class="bi bi-grid-1x2-fill text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-cyan-500 mr-2"></i>
                        Aplikasi Sekolah
                    </h2>
                    <div
                        class="h-[2px] bg-gradient-to-r from-transparent via-blue-300 to-transparent flex-grow max-w-xs">
                    </div>
                </div>

                <div id="status-summary" class="text-center mb-8"></div>

                <div id="aplikasi-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
            </section>

            <!-- ===== BERITA TERKINI ===== -->
            <section class="perf-section search-section" id="berita-section">
                <div class="flex items-center justify-center gap-4 mb-10">
                    <div class="h-[2px] bg-gradient-to-r from-transparent via-blue-300 to-transparent flex-grow max-w-xs">
                    </div>
                    <h2
                        class="font-sans font-black text-slate-800 tracking-widest uppercase text-sm md:text-base px-8 py-2.5 bg-white/60 backdrop-blur border border-white shadow-sm rounded-full text-center">
                        <i
                            class="bi bi-newspaper text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-cyan-500 mr-2"></i>
                        Berita Terkini
                    </h2>
                    <div class="h-[2px] bg-gradient-to-r from-transparent via-blue-300 to-transparent flex-grow max-w-xs">
                    </div>
                </div>

                <div id="berita-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    <div
                        class="berita-skeleton animate-pulse glass-panel rounded-[2rem] overflow-hidden border border-white shadow-glass">
                        <div class="w-full h-44 bg-slate-200/70 rounded-t-[2rem]"></div>
                        <div class="p-5 space-y-3">
                            <div class="h-3 bg-slate-200/70 rounded-full w-1/3"></div>
                            <div class="h-5 bg-slate-200/70 rounded-full w-full"></div>
                            <div class="h-5 bg-slate-200/70 rounded-full w-4/5"></div>
                            <div class="h-3 bg-slate-200/70 rounded-full w-full"></div>
                            <div class="h-3 bg-slate-200/70 rounded-full w-2/3"></div>
                        </div>
                    </div>
                    <div
                        class="berita-skeleton animate-pulse glass-panel rounded-[2rem] overflow-hidden border border-white shadow-glass hidden sm:block">
                        <div class="w-full h-44 bg-slate-200/70 rounded-t-[2rem]"></div>
                        <div class="p-5 space-y-3">
                            <div class="h-3 bg-slate-200/70 rounded-full w-1/3"></div>
                            <div class="h-5 bg-slate-200/70 rounded-full w-full"></div>
                            <div class="h-5 bg-slate-200/70 rounded-full w-4/5"></div>
                            <div class="h-3 bg-slate-200/70 rounded-full w-full"></div>
                            <div class="h-3 bg-slate-200/70 rounded-full w-2/3"></div>
                        </div>
                    </div>
                    <div
                        class="berita-skeleton animate-pulse glass-panel rounded-[2rem] overflow-hidden border border-white shadow-glass hidden lg:block">
                        <div class="w-full h-44 bg-slate-200/70 rounded-t-[2rem]"></div>
                        <div class="p-5 space-y-3">
                            <div class="h-3 bg-slate-200/70 rounded-full w-1/3"></div>
                            <div class="h-5 bg-slate-200/70 rounded-full w-full"></div>
                            <div class="h-5 bg-slate-200/70 rounded-full w-4/5"></div>
                            <div class="h-3 bg-slate-200/70 rounded-full w-full"></div>
                            <div class="h-3 bg-slate-200/70 rounded-full w-2/3"></div>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-8">
                    <a href="https://sman2mengwi.sch.id" target="_blank"
                        class="inline-flex items-center gap-2 px-7 py-3 rounded-full font-bold text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 shadow-lg shadow-blue-500/30 hover:shadow-blue-500/50 hover:-translate-y-0.5 transition-all duration-300">
                        <i class="bi bi-arrow-up-right-circle-fill"></i>
                        Lihat Semua Berita
                    </a>
                </div>
            </section>

            <!-- Pembelajaran & Ekstrakurikuler -->
            <div id="search-section-belajar" class="grid grid-cols-1 lg:grid-cols-2 gap-12 perf-section search-section">
                <section
                    class="glass-panel p-8 rounded-[2.5rem] border border-white shadow-[0_8px_30px_rgba(0,0,0,0.04)] relative overflow-hidden group">
                    <div
                        class="absolute -top-20 -right-20 w-64 h-64 bg-amber-400/20 blur-[60px] rounded-full group-hover:bg-amber-400/30 transition-colors duration-700">
                    </div>
                    <h2 class="font-extrabold text-slate-800 text-2xl mb-8 flex items-center gap-4 relative z-10">
                        <div
                            class="w-12 h-12 flex items-center justify-center bg-gradient-to-br from-amber-400 to-orange-500 text-white rounded-[1rem] shadow-lg shadow-amber-500/30">
                            <i class="bi bi-book-half text-xl"></i>
                        </div>
                        Pembelajaran
                    </h2>
                    <div class="flex flex-col gap-4 relative z-10">

                        <a href="https://gamesosiologi.dwisma.id" target="_blank"
                            class="perf-card flex items-center gap-5 p-4 bg-white/70 backdrop-blur-sm rounded-2xl border border-white shadow-sm hover:shadow-[0_10px_20px_-5px_rgba(139,92,246,0.2)] hover:-translate-y-1 transition-all duration-300">
                            <div
                                class="w-12 h-12 bg-white rounded-xl flex items-center justify-center p-2 shadow-sm border border-slate-100">
                                <i class="bi bi-controller text-2xl text-violet-500"></i>
                            </div>
                            <span
                                class="font-bold text-lg text-slate-700 flex-1 hover:text-violet-600 transition-colors">Game
                                Sosiologi</span>
                            <div class="w-8 h-8 rounded-full bg-violet-50 flex items-center justify-center">
                                <i class="bi bi-chevron-right text-violet-500"></i>
                            </div>
                        </a>

                        <a href="https://websejarah.dwisma.id" target="_blank"
                            class="perf-card flex items-center gap-5 p-4 bg-white/70 backdrop-blur-sm rounded-2xl border border-white shadow-sm hover:shadow-[0_10px_20px_-5px_rgba(59,130,246,0.2)] hover:-translate-y-1 transition-all duration-300">
                            <div
                                class="w-12 h-12 bg-white rounded-xl flex items-center justify-center p-2 shadow-sm border border-slate-100">
                                <img src="/img/Logo Dwisma.png" class="object-contain w-full h-full drop-shadow-sm"
                                    alt="" />
                            </div>
                            <span
                                class="font-bold text-lg text-slate-700 flex-1 hover:text-blue-600 transition-colors">Sejarah</span>
                            <div class="w-8 h-8 rounded-full bg-blue-50 flex items-center justify-center">
                                <i class="bi bi-chevron-right text-blue-500"></i>
                            </div>
                        </a>

                        <a href="https://sosiologi.dwisma.id" target="_blank"
                            class="perf-card flex items-center gap-5 p-4 bg-white/70 backdrop-blur-sm rounded-2xl border border-white shadow-sm hover:shadow-[0_10px_20px_-5px_rgba(245,158,11,0.2)] hover:-translate-y-1 transition-all duration-300">
                            <div
                                class="w-12 h-12 bg-white rounded-xl flex items-center justify-center p-2 shadow-sm border border-slate-100">
                                <img src="/img/logososiologi.png" loading="lazy"
                                    class="object-contain w-full h-full drop-shadow-sm" alt="" />
                            </div>
                            <span
                                class="font-bold text-lg text-slate-700 flex-1 hover:text-amber-600 transition-colors">Sosiologi</span>
                            <div class="w-8 h-8 rounded-full bg-amber-50 flex items-center justify-center">
                                <i class="bi bi-chevron-right text-amber-500"></i>
                            </div>
                        </a>
                    </div>
                </section>

                <section
                    class="glass-panel p-8 rounded-[2.5rem] border border-white shadow-[0_8px_30px_rgba(0,0,0,0.04)] relative overflow-hidden group">
                    <div
                        class="absolute -top-20 -right-20 w-64 h-64 bg-green-400/20 blur-[60px] rounded-full group-hover:bg-green-400/30 transition-colors duration-700">
                    </div>
                    <h2 class="font-extrabold text-slate-800 text-2xl mb-8 flex items-center gap-4 relative z-10">
                        <div
                            class="w-12 h-12 flex items-center justify-center bg-gradient-to-br from-green-400 to-emerald-600 text-white rounded-[1rem] shadow-lg shadow-green-500/30">
                            <i class="bi bi-stars text-xl"></i>
                        </div>
                        Ekstrakurikuler
                    </h2>
                    <div class="flex flex-col gap-4 relative z-10">

                        <a href="https://informatika.dwisma.id" target="_blank"
                            class="perf-card flex items-center gap-5 p-4 bg-white/70 backdrop-blur-sm rounded-2xl border border-white shadow-sm hover:shadow-[0_10px_20px_-5px_rgba(14,165,233,0.2)] hover:-translate-y-1 transition-all duration-300">
                            <div
                                class="w-12 h-12 bg-white rounded-xl flex items-center justify-center p-2 shadow-sm border border-slate-100">
                                <img src="/img/Logo Dwisma.png" class="object-contain w-full h-full drop-shadow-sm"
                                    alt="" />
                            </div>
                            <span
                                class="font-bold text-lg text-slate-700 flex-1 hover:text-sky-600 transition-colors">Informatika</span>
                            <div class="w-8 h-8 rounded-full bg-sky-50 flex items-center justify-center">
                                <i class="bi bi-chevron-right text-sky-500"></i>
                            </div>
                        </a>

                        <a href="https://sispala.dwisma.id" target="_blank"
                            class="perf-card flex items-center gap-5 p-4 bg-white/70 backdrop-blur-sm rounded-2xl border border-white shadow-sm hover:shadow-[0_10px_20px_-5px_rgba(16,185,129,0.2)] hover:-translate-y-1 transition-all duration-300">
                            <div
                                class="w-12 h-12 bg-white rounded-xl flex items-center justify-center p-2 shadow-sm border border-slate-100">
                                <img src="/img/logosispala.png" loading="lazy"
                                    class="object-contain w-full h-full drop-shadow-sm" alt="" />
                            </div>
                            <span
                                class="font-bold text-lg text-slate-700 flex-1 hover:text-emerald-600 transition-colors">Sispala</span>
                            <div class="w-8 h-8 rounded-full bg-emerald-50 flex items-center justify-center">
                                <i class="bi bi-chevron-right text-emerald-500"></i>
                            </div>
                        </a>
                    </div>
                </section>
            </div>

            <!-- Platform Merdeka Mengajar Banner -->
